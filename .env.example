# 複製為 .env 後按需修改：  cp .env.example .env
# 所有項目都是可選的；全部不設定也能直接跑起來（http://伺服器IP:3000）。

# ── 對外網址（強烈建議在正式環境設定）──────────────────────
# 你的網站網址（含 https://）。用於寫入請求的來源檢查、郵件內的連結和 QR 登入卡。
APP_URL=

# 是否信任前置代理傳來的真實 IP（影響登入限流的準確度）：
#   none       直接對外，不信任任何標頭（默認）
#   cloudflare 在 Cloudflare / Cloudflare Tunnel 之後
#   xff        在 Caddy / Nginx 之後（代理必須自己覆寫 X-Forwarded-For）
TRUST_PROXY=none

# ── 首次設定 ────────────────────────────────────────────────
# 首次啟動時設定精靈需要一個「設定碼」，預設會自動產生並印在日誌：docker compose logs app
# 想固定設定碼就填這裡；確定部署在受保護的環境才可把 REQUIRE 設為 false。
SETUP_TOKEN=
SETUP_REQUIRE_TOKEN=true

# ── Cookie ──────────────────────────────────────────────────
# 留空＝自動判斷（HTTPS 時啟用 Secure）。
COOKIE_SECURE=

# ── 郵件（Resend）──────────────────────────────────────────
# 一般建議在「管理後台 → 郵件服務」設定（金鑰會加密存進資料庫）。
# 這裡只是給自動化部署用的後備；後台設定的優先。
RESEND_API_KEY=

# ── 備份 ────────────────────────────────────────────────────
# 後台「匯入並還原」允許上傳的備份檔大小上限（MB）。經代理上傳時，代理本身可能另有限制。
BACKUP_MAX_MB=512

# ── Docker Compose 專用 ─────────────────────────────────────
# VPS 只拉鏡像的部署（deploy/docker-compose.yml）需要：GitHub Actions 發佈的鏡像位置，全小寫
# 例：ghcr.io/你的用戶名/hk-primary-learn:latest
APP_IMAGE=
# 對外連接埠；放在反向代理後面時可改成 BIND=127.0.0.1 只開放本機
PORT=3000
BIND=0.0.0.0
# 用 --profile caddy 時填你的網域（DNS 要先指向這台伺服器）
DOMAIN=
# 用 --profile tunnel 時填 Cloudflare Tunnel 的 token
TUNNEL_TOKEN=
